\n    pb = [p[(qi_arr == q) & hardmask].mean() - p[(qi_arr == q) & beatmask].mean() for q in np.unique(qi_arr[~A]) if ((qi_arr == q) & beatmask).any()]\n    extra = \"\"\n    if L == 6:\n        hp = hn - (hn @ r) * r; hp /= np.linalg.norm(hp); pp = X @ hp\n        pbp = [pp[(qi_arr == q) & hardmask].mean() - pp[(qi_arr == q) & beatmask].mean() for q in np.unique(qi_arr[~A]) if ((qi_arr == q) & beatmask).any()]\n        extra = \" | cos(r)=%.2f, orth-part B paired mean/sd=%.2f (frac>0 %.2f)\" % (hn @ r, np.mean(pbp) / np.std(pbp), np.mean(np.array(pbp) > 0))\n        np.save(WORK / \"hard_dir_L6.npy\", hn); np.save(WORK / \"hard_dir_L6_perp.npy\", hp)\n    print(\"L%d hard-dir (nA=%d): B paired mean/sd=%.2f, frac>0=%.2f, corr(score)=%.2f, corr(ov)=%.2f%s\" % (L, n, np.mean(pb) / np.std(pb), np.mean(np.array(pb) > 0),\n          np.corrcoef(cq(p), s0c)[0,1], np.corrcoef(cq(p), ovc)[0,1], extra))\nprint(pd.DataFrame({\"hard_gold\": F[hardmask][[\"has_ans\",\"overlap\",\"title_in_q\",\"ntok\"]].mean(), \"beating_distr\": F[beatmask][[\"has_ans\",\"overlap\",\"title_in_q\",\"ntok\"]].mean()}).round(2).T)\n```","ttft_ms":23511,"type":"result","duration_ms":39328,"uuid":"bfae7fb4-70b7-4853-af35-26413784b447","ttft_stream_ms":3165,"time_to_request_ms":1070,"time_to_request_phases_ms":{"other":20,"system_prompt":108,"resume_other":1,"process_user_input":7,"input_attachments":47,"input_hooks":61,"conversation_append":2,"transcript_persist":633,"tool_pool_refresh":7,"init_message":20,"init_frame_send":3,"engine_pickup":4,"loop_entry":9,"message_prep":2,"model_config_wait":3,"autocompact":5,"request_announcements":14,"query_setup":3,"model_gates":1,"tool_schema_build":6,"message_normalization":36,"client_creation":21,"request_build":57},"turn_start_resume_kind":"none","process_turn_index":0,"time_to_request_loop_lag_ms":315,"time_to_request_cpu_ms":609,"time_to_request_major_faults":5207,"input_attachments_detail":{"slowest_producer":"async_hook_responses","slowest_producer_ms